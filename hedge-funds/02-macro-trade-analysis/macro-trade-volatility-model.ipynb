# **USDKRW Implied Volatility Model**
"""

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Load the Data
df = pd.read_csv('USDKRW.csv', sep=';')

# Clean the Data
# Select only the relevant columns and rename them
df = df[['Date', 'USDKRW', 'USDKWN 3M']].copy()
df.columns = ['Date', 'Spot', 'Forward_3M']

# Ensure Date is properly formatted and sorted ascending (2021 -> 2026)
df['Date'] = pd.to_datetime(df['Date'], errors='coerce')
df = df.dropna(subset=['Date'])
df = df.sort_values('Date').reset_index(drop=True)

# Replace European commas with dots and convert to numeric
for col in ['Spot', 'Forward_3M']:
    df[col] = df[col].astype(str).str.replace(',', '.')
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Forward-fill missing prices (e.g., weekends/holidays) and drop pure NaNs
df['Spot'] = df['Spot'].ffill()
df['Forward_3M'] = df['Forward_3M'].ffill()
df = df.dropna(subset=['Spot', 'Forward_3M'])

# Calculate Market-Implied Yield Differential (CIRP)
# T = 0.25 (3 months)
df['Yield_Diff'] = (1 / 0.25) * np.log(df['Forward_3M'] / df['Spot'])

# Calculate Daily Change & 21-Day Rolling Volatility
df['Daily_Change'] = df['Yield_Diff'].diff()
df['Rolling_Vol_21D'] = df['Daily_Change'].rolling(window=21).std() * np.sqrt(252)

# Benchmarking: Z-Score and Percentile Rank (5-Year Lookback)
valid_vol = df['Rolling_Vol_21D'].dropna()
vol_mean = valid_vol.mean()
vol_std = valid_vol.std()

df['Z_Score'] = (df['Rolling_Vol_21D'] - vol_mean) / vol_std
df['Percentile_Rank'] = df['Rolling_Vol_21D'].rank(pct=True)

# Extract the Latest Data Point for the Report
latest_data = df.iloc[-1]
print("=== 5-YEAR MACRO VOLATILITY BENCHMARK ===")
print(f"Date: {latest_data['Date'].date()}")
print(f"Implied Yield Diff: {latest_data['Yield_Diff']:.4f}")
print(f"21-Day Volatility: {latest_data['Rolling_Vol_21D']:.4f}")
print(f"Z-Score: {latest_data['Z_Score']:.2f}")
print(f"Percentile Rank: {latest_data['Percentile_Rank'] * 100:.1f}th Percentile\n")

# Generate the Institutional Chart
plt.figure(figsize=(10, 5))
plt.plot(df['Date'], df['Rolling_Vol_21D'], color='darkblue', linewidth=1.5, label='21-Day Rolling Volatility')

# Add threshold lines based on the 5-year data
plt.axhline(vol_mean, color='black', linestyle='--', label='5-Year Historical Average')
plt.axhline(vol_mean + (1.5 * vol_std), color='red', linestyle=':', label='+1.5 Z-Score (High Volatility Regime)')

# Highlight the current cheap volatility
plt.scatter(latest_data['Date'], latest_data['Rolling_Vol_21D'], color='green', s=100, zorder=5, label='Current State (Cheap IV)')

plt.title('USD/KRW Forward-Implied Yield Differential Volatility (2021-2026)', fontsize=14, fontweight='bold')
plt.ylabel('Annualized Volatility', fontsize=12)
plt.xlabel('Date', fontsize=12)
plt.legend(loc='upper left')
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig('5_Year_Volatility_Chart.png') # Saves the file to your directory

