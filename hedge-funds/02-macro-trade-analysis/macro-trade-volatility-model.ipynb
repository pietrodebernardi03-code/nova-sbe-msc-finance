# **USDCHFR Implied Volatility Model**"""

# Load data
df = pd.read_csv('USDCHF.csv', sep=';')
df = df[['Date', 'USDCHF', 'USDCHF 3M']].copy()
df.columns = ['Date', 'Spot', 'Forward_3M']

# Parse Dates robustly
df['Date'] = pd.to_datetime(df['Date'], errors='coerce')

def parse_dirty_prices(val):
    """
    Cleans vendor misprints like '1508.00.00' into standard float 1508.00
    """
    if pd.isna(val):
        return np.nan
    val_str = str(val).replace(',', '.')
    parts = val_str.split('.')
    if len(parts) > 2:
        val_str = f"{parts[0]}.{parts[1]}"
    try:
        return float(val_str)
    except ValueError:
        return np.nan

df['Spot'] = df['Spot'].apply(parse_dirty_prices)
df['Forward_3M'] = df['Forward_3M'].apply(parse_dirty_prices)

# Normalize the Forward prices.
# The data vendor multiplied Forward_3M by 100 relative to the Spot.
df['Forward_3M'] = df['Forward_3M'] / 100

df = df.dropna(subset=['Date', 'Spot', 'Forward_3M'])
df = df.sort_values('Date').reset_index(drop=True)

# Erase severe vendor typos (e.g., Spot showing as 6.20 instead of 1606.20)
# we replace them with NaN if the Forward/Spot ratio deviates heavily from 1.0
invalid_rows = (df['Forward_3M'] / df['Spot'] < 0.8) | (df['Forward_3M'] / df['Spot'] > 1.2)
df.loc[invalid_rows, ['Spot', 'Forward_3M']] = np.nan

# Forward-fill the gaps to maintain time-series integrity
df['Spot'] = df['Spot'].ffill()
df['Forward_3M'] = df['Forward_3M'].ffill()
df = df.dropna().copy()

# T = 0.25 (3 months) calculation
df['Yield_Diff'] = (1 / 0.25) * np.log(df['Forward_3M'] / df['Spot'])

# Mathematical Winsorization (Clipping the 1% extreme tails to avoid chart flattening)
lower_bound = df['Yield_Diff'].quantile(0.01)
upper_bound = df['Yield_Diff'].quantile(0.99)
df['Yield_Diff'] = np.clip(df['Yield_Diff'], lower_bound, upper_bound)

# 21-Day Rolling Volatility Calculation
df['Daily_Change'] = df['Yield_Diff'].diff()
df['Rolling_Vol_21D'] = df['Daily_Change'].rolling(window=21).std() * np.sqrt(252)

# Drop final NaNs from the rolling window math
df = df.dropna().copy()

# Statistical Benchmarking
vol_mean = df['Rolling_Vol_21D'].mean()
vol_std = df['Rolling_Vol_21D'].std()
df['Z_Score'] = (df['Rolling_Vol_21D'] - vol_mean) / vol_std
df['Percentile_Rank'] = df['Rolling_Vol_21D'].rank(pct=True)

# Output table
latest_data = df.iloc[-1]
print("=== 5-YEAR MACRO VOLATILITY BENCHMARK ===")
print(f"Date: {latest_data['Date'].date()}")
print(f"Implied Yield Diff: {latest_data['Yield_Diff']:.4f}")
print(f"21-Day Volatility: {latest_data['Rolling_Vol_21D']:.4f}")
print(f"Z-Score: {latest_data['Z_Score']:.2f}")
print(f"Percentile Rank: {latest_data['Percentile_Rank'] * 100:.1f}th Percentile\n")

# Plotting
plt.figure(figsize=(12, 6))
plt.plot(df['Date'], df['Rolling_Vol_21D'], color='#1f77b4', linewidth=1.5, label='21-Day Rolling Volatility')
plt.axhline(vol_mean, color='black', linestyle='--', alpha=0.7, label='Historical Mean')
plt.axhline(vol_mean + (1.5 * vol_std), color='#d62728', linestyle=':', linewidth=2, label='+1.5 Z-Score (High Vol Regime)')
plt.axhline(vol_mean - (1.5 * vol_std), color='#2ca02c', linestyle=':', linewidth=2, label='-1.5 Z-Score (Low Vol Regime)')
plt.scatter(latest_data['Date'], latest_data['Rolling_Vol_21D'], color='gold', edgecolor='black', s=120, zorder=5, label='Current State')
plt.title('USD/CHF Implied Yield Volatility', fontsize=14, fontweight='bold')
plt.ylabel('Annualized Volatility', fontsize=12)
plt.xlabel('Date', fontsize=12)
plt.legend(loc='best')
plt.grid(alpha=0.3, linestyle='--')
plt.tight_layout()
plt.savefig('5_Year_Volatility_Chart_Fixed.png', dpi=300)
plt.show()