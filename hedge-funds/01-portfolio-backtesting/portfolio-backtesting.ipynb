import pandas as pd
import numpy as np
import yfinance as yf
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.optimize import minimize

# ============================================================================
# STEP 1 & 2: STRATEGY OPTIMIZATION AND ASSET CLASS AGGREGATION
# ============================================================================

# --- 1.1: DATA ACQUISITION ---
asset_classes = {
    'Equities': ["ES=F", "YM=F", "NQ=F"],
    'Bonds': ["ZN=F", "ZF=F", "ZT=F"],
    'Commodities': ["GC=F", "SI=F", "HG=F"]
}

all_tickers = [ticker for group in asset_classes.values() for ticker in group]
raw_data = yf.download(all_tickers, start="2007-01-01", interval="1d", auto_adjust=False, progress=False)

if isinstance(raw_data.columns, pd.MultiIndex):
    data = raw_data['Adj Close'].copy() if 'Adj Close' in raw_data.columns.levels[0] else raw_data['Close'].copy()
else:
    data = raw_data.copy()

data = data.ffill().dropna()
print(f"Dataset: {data.shape[0]} days, {data.shape[1]} assets")

# --- 1.2: STRATEGY FUNCTIONS ---
def calculate_sharpe(series):
    """Calculate annualized Sharpe ratio"""
    if series.std() == 0:
        return -np.inf
    return (series.mean() / series.std()) * np.sqrt(252)

def run_strategy(prices, window, num_std, strategy_type):
    """Execute TF or MR strategy"""
    sma = prices.rolling(window=window).mean()
    std = prices.rolling(window=window).std()
    upper = sma + (num_std * std)
    lower = sma - (num_std * std)

    signals = pd.Series(0, index=prices.index)

    if strategy_type == 'TF':
        signals[prices > upper] = 1
        signals[prices < lower] = -1
    else:  # MR
        signals[prices > upper] = -1
        signals[prices < lower] = 1

    return signals.shift(1) * prices.pct_change()

# --- 1.3: OPTIMIZE EACH ASSET CLASS ---
windows = [20, 50, 100, 200]
std_devs = [0.5, 1.0, 1.5, 2.0]

asset_class_returns = pd.DataFrame(index=data.index)
optimization_log = []

print("\n" + "="*80)
print("STEP 1 & 2: OPTIMIZING STRATEGIES PER ASSET CLASS")
print("="*80)

for class_name, tickers in asset_classes.items():
    valid_tickers = [t for t in tickers if t in data.columns]
    best_overall_sharpe = -np.inf
    best_strategy = None
    best_params = None
    best_returns = None

    # Test both TF and MR
    for strat_type in ['TF', 'MR']:
        for w in windows:
            for s in std_devs:
                # Calculate returns for each ticker in the class
                individual_returns = pd.DataFrame()
                for t in valid_tickers:
                    individual_returns[t] = run_strategy(data[t], w, s, strat_type)

                # Aggregate using equal weights (as per assignment)
                aggregated = individual_returns.mean(axis=1)
                sharpe = calculate_sharpe(aggregated)

                if sharpe > best_overall_sharpe:
                    best_overall_sharpe = sharpe
                    best_strategy = strat_type
                    best_params = (w, s)
                    best_returns = aggregated

    # Store the winning strategy for this asset class
    asset_class_returns[class_name] = best_returns

    optimization_log.append({
        'Asset Class': class_name,
        'Strategy': best_strategy,
        'Window': best_params[0],
        'Std Dev': best_params[1],
        'Sharpe': best_overall_sharpe,
        'Tickers': len(valid_tickers)
    })

    print(f"{class_name:<12} | {best_strategy} | MA={best_params[0]:>3} σ={best_params[1]:.1f} | Sharpe={best_overall_sharpe:>6.3f}")

# Display optimization summary
opt_summary = pd.DataFrame(optimization_log)
print("\n" + opt_summary.to_string(index=False))

# ============================================================================
# STEP 3: PORTFOLIO CONSTRUCTION (TANGENCY VS RISK PARITY)
# ============================================================================

print("\n" + "="*80)
print("STEP 3: PORTFOLIO OPTIMIZATION")
print("="*80)

# Prepare data
mu = asset_class_returns.mean() * 252
sigma = asset_class_returns.cov() * 252
asset_names = asset_class_returns.columns.tolist()

# --- 3.1: TANGENCY PORTFOLIO (MVO WITH CONSTRAINTS) ---
def neg_sharpe(weights, mu, sigma):
    ret = np.sum(weights * mu)
    vol = np.sqrt(weights.T @ sigma @ weights)
    return -ret / vol if vol != 0 else 0

def find_tangency_constrained(mu, sigma):
    num_assets = len(mu)
    constraints = ({'type': 'eq', 'fun': lambda x: np.sum(x) - 1})

    # Assignment constraints: Equities/Bonds ≤50%, Commodities ≤25%
    bounds = []
    for asset in asset_names:
        if 'Commodities' in asset:
            bounds.append((0.0, 0.25))
        else:
            bounds.append((0.0, 0.50))

    initial = np.array([1/num_assets] * num_assets)
    result = minimize(neg_sharpe, initial, args=(mu, sigma),
                      method='SLSQP', bounds=tuple(bounds), constraints=constraints)
    return result.x

tangency_weights = find_tangency_constrained(mu, sigma)

# --- 3.2: RISK PARITY (INVERSE VOLATILITY) ---
inv_vol = 1.0 / np.sqrt(np.diag(sigma))
risk_parity_weights = inv_vol / np.sum(inv_vol)

# --- 3.3: BACKTEST PORTFOLIOS ---
ret_tangency = (asset_class_returns * tangency_weights).sum(axis=1)
ret_risk_parity = (asset_class_returns * risk_parity_weights).sum(axis=1)

strategy_comparison = pd.DataFrame({
    'Tangency': ret_tangency,
    'Risk Parity': ret_risk_parity
})

# Display weights
weights_df = pd.DataFrame({
    'Tangency': tangency_weights,
    'Risk Parity': risk_parity_weights
}, index=asset_names)

print("\nOptimized Weights:")
print(weights_df.apply(lambda x: x.apply(lambda v: f"{v:.1%}")))

# ============================================================================
# STEP 4: REGIME ANALYSIS (MARKET, RATES, VOLATILITY)
# ============================================================================

print("\n" + "="*80)
print("STEP 4: IDENTIFYING REGIME INDICATORS")
print("="*80)

# --- 4.1: DOWNLOAD MACRO INDICATORS ---
macro_tickers = {
    '^GSPC': 'SP500',       # Market Trend
    '^VIX': 'VIX',          # Volatility
    '^TNX': 'US10Y'         # Interest Rates
}

# Download only 'Close' to avoid issues with missing 'Adj Close' for indices
macro_data = yf.download(list(macro_tickers.keys()), start="2007-01-01",
                          interval="1d", progress=False)['Close']
macro_data = macro_data.rename(columns=macro_tickers)

# Align macro data with strategy returns
# Forward fill to propagate last known values (handling holidays/weekends)
macro_data = macro_data.reindex(strategy_comparison.index).ffill()

# --- 4.2: DEFINE REGIMES ---
df_regime = strategy_comparison.copy()
df_regime['Spread'] = df_regime['Tangency'] - df_regime['Risk Parity']
df_regime = df_regime.join(macro_data).dropna()

# 1. Market Trend Regime (Bull vs Bear)
# Bull Market = SP500 > 200-day Moving Average
sp500_ma = df_regime['SP500'].rolling(200).mean()
df_regime['Regime_Growth'] = np.where(df_regime['SP500'] > sp500_ma, 'Bull Market', 'Bear Market')

# 2. Interest Rate Regime (Rising vs Falling)
# Rising Rates = 10Y Yield Change (60 days) > 0
yield_change = df_regime['US10Y'].diff(60)
df_regime['Regime_Rates'] = np.where(yield_change > 0, 'Rising Rates', 'Falling Rates')

# 3. Volatility Regime (VIX Levels)
vix_bins = [0, 15, 25, 50, np.inf]
vix_labels = ['Low (<15)', 'Medium (15-25)', 'High (25-50)', 'Extreme (>50)']
df_regime['Regime_Vol'] = pd.cut(df_regime['VIX'], bins=vix_bins, labels=vix_labels)

# Remove initial rows where rolling calculations (MA, diff) produce NaN
df_regime = df_regime.dropna()

# --- 4.3: ANALYZE PERFORMANCE PER REGIME ---

def analyze_regime_performance(df, regime_col, indicator_name):
    """
    Calculates statistics for Tangency vs Risk Parity spread in different regimes.
    """
    print(f"\n--- Analysis: {indicator_name} ---")

    # Group by regime
    groups = df.groupby(regime_col, observed=False)

    # Calculate Summary Statistics
    summary = pd.DataFrame({
        'Ann. Spread': groups['Spread'].mean() * 252,
        'Daily Volatility': groups['Spread'].std() * np.sqrt(252),
        'Days Observed': groups['Spread'].count()
    })

    # Add Win Rate (Frequency of Positive Spread days)
    # Win Rate = % of days Tangency beats Risk Parity
    win_rate = df.groupby(regime_col, observed=False)['Spread'].apply(lambda x: (x > 0).mean())
    summary['Win Rate'] = win_rate

    # Format for display
    display_df = summary.copy()
    for col in ['Ann. Spread', 'Daily Volatility', 'Win Rate']:
        display_df[col] = display_df[col].apply(lambda x: f"{x:.2%}")

    print(display_df.to_string())

    # Return best performing regime for insight
    best_regime = summary['Ann. Spread'].idxmax()
    print(f"> Insight: Tangency performs best in '{best_regime}' regime.")

# Run Analysis for all 3 Indicators
analyze_regime_performance(df_regime, 'Regime_Growth', 'Market Trend (S&P 500)')
analyze_regime_performance(df_regime, 'Regime_Rates', 'Interest Rate Environment (10Y Yield)')
analyze_regime_performance(df_regime, 'Regime_Vol', 'Volatility Levels (VIX)')

print("\n" + "-"*80)
print("CONCLUSION STEP 4:")
print("While Market Trend and Rates show distinct patterns, VIX provides the most granular")
print("and actionable signal for switching (clear segmentation between Low/Medium and High/Extreme).")
print("We will proceed with VIX > 25 as the switching trigger.")
print("-"*-80)

