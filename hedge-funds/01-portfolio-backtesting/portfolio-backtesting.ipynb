# ============================================================================
# SENSITIVITY ANALYSIS (AVOID OVERFITTING)
# ============================================================================

print("\n" + "="*80)
print("SENSITIVITY ANALYSIS: VIX THRESHOLD")
print("="*80)

thresholds = [20, 22, 25, 27, 30]
sensitivity_results = []

for thresh in thresholds:
    regime_ret = []
    for date in asset_class_returns.index:
        if date not in macro_data.index or pd.isna(macro_data.loc[date, 'VIX']):
            continue
        vix = macro_data.loc[date, 'VIX']
        w = risk_parity_weights if vix > thresh else tangency_weights
        regime_ret.append((asset_class_returns.loc[date] * w).sum())

    series = pd.Series(regime_ret, index=asset_class_returns.index[:len(regime_ret)])
    sharpe = calculate_sharpe(series)
    sensitivity_results.append({'Threshold': thresh, 'Sharpe': sharpe})

sens_df = pd.DataFrame(sensitivity_results)
print("\nSharpe Ratio by VIX Threshold:")
print(sens_df.to_string(index=False))

