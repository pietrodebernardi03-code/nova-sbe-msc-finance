print("\n" + "="*80)
print("STEP 5: REGIME-SWITCHING STRATEGY")
print("="*80)

# --- 5.1: IMPLEMENT SWITCHING LOGIC ---
VIX_THRESHOLD = 25

regime_returns = []
active_regime = []

for date in asset_class_returns.index:
    if date not in macro_data.index or pd.isna(macro_data.loc[date, 'VIX']):
        continue

    vix = macro_data.loc[date, 'VIX']

    # Select weights based on regime
    weights = risk_parity_weights if vix > VIX_THRESHOLD else tangency_weights

    # Calculate return
    daily_ret = (asset_class_returns.loc[date] * weights).sum()
    regime_returns.append(daily_ret)
    active_regime.append('Risk Parity' if vix > VIX_THRESHOLD else 'Tangency')

regime_switching = pd.Series(regime_returns,
                               index=asset_class_returns.index[:len(regime_returns)])

# --- 5.2: COMPREHENSIVE COMPARISON ---
all_strategies = pd.DataFrame({
    'Tangency (Fixed)': ret_tangency,
    'Risk Parity (Fixed)': ret_risk_parity,
    'Regime-Switching': regime_switching
}).dropna()

# --- 5.3: CALCULATE METRICS ---
def calculate_metrics(returns, name):
    ann_ret = returns.mean() * 252
    ann_vol = returns.std() * np.sqrt(252)
    sharpe = ann_ret / ann_vol

    cum_rets = (1 + returns).cumprod()
    total_ret = cum_rets.iloc[-1] - 1

    running_max = cum_rets.expanding().max()
    drawdown = (cum_rets - running_max) / running_max
    max_dd = drawdown.min()

    pos_days = (returns > 0).sum() / len(returns)

    monthly = returns.resample('ME').apply(lambda x: (1 + x).prod() - 1)
    pos_months = (monthly > 0).sum() / len(monthly)

    return {
        'Strategy': name,
        'Ann. Return': ann_ret,
        'Ann. Vol': ann_vol,
        'Sharpe': sharpe,
        'Total Return': total_ret,
        'Max DD': max_dd,
        '% Pos Days': pos_days,
        '% Pos Months': pos_months
    }

metrics = [calculate_metrics(all_strategies[col], col) for col in all_strategies.columns]
performance = pd.DataFrame(metrics)

# Format for display
display_metrics = performance.copy()
for col in ['Ann. Return', 'Ann. Vol', 'Total Return', 'Max DD', '% Pos Days', '% Pos Months']:
    display_metrics[col] = display_metrics[col].apply(lambda x: f"{x:.2%}")
display_metrics['Sharpe'] = display_metrics['Sharpe'].apply(lambda x: f"{x:.3f}")

print("\n📊 FINAL PERFORMANCE COMPARISON:")
print(display_metrics.to_string(index=False))

# Regime activity
regime_pct = pd.Series(active_regime).value_counts(normalize=True)
switches = (pd.Series(active_regime) != pd.Series(active_regime).shift()).sum()

print(f"\n📈 REGIME ACTIVITY:")
