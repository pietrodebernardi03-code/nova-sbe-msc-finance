import warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates

warnings.filterwarnings("ignore")

# ── Configuration ─────────────────────────────────────────────────────────────

EXCEL_PATH      = "Data Assignment 3 2010.xlsx"
START_DATE      = "2014-01-01"
INSAMPLE_END    = "2020-12-31"
OUTSAMPLE_START = "2021-01-01"
N_LONG          = 20
N_SHORT         = 20
BUFFER          = 6         # N+6 rule to mitigate turnover
COST_ONE_WAY    = 0.0005    # 5bps transaction cost


# ── Data Ingestion ────────────────────────────────────────────────────────────

def load_excel(path):
    """Parses raw Bloomberg output into aligned cross-sectional DataFrames."""
    raw = pd.read_excel(path, sheet_name="Data", header=None)

    field_row  = raw.iloc[2, :]
    ticker_row = raw.iloc[1, :]
    data_rows  = raw.iloc[3:, :]
    dates      = pd.to_datetime(data_rows.iloc[:, 3].values)

    fields = [
        "PX_LAST", "RETURN_COM_EQY", "PROF_MARGIN",
        "EBITDA_EV_YIELD", "OPER_INC_GROWTH",
    ]

    data = {}
    for field in fields:
        col_idxs = field_row[field_row == field].index.tolist()
        if not col_idxs:
            continue
        block = data_rows.iloc[:, col_idxs].copy()
        block.columns = ticker_row.iloc[col_idxs].tolist()
        block.index   = dates
        block = block.apply(pd.to_numeric, errors="coerce").dropna(axis=1, how="all")
        data[field] = block

    print(f"Loaded {len(data)} fields, {data['PX_LAST'].shape[1]} tickers, "
          f"{dates[0].date()} to {dates[-1].date()}")
    return data


# ── Factor Construction ───────────────────────────────────────────────────────

def build_factors(data):
    """Applies a 3-month reporting lag and initial outlier clipping."""
    factors = {
        "Earnings Yield":   data["EBITDA_EV_YIELD"].shift(3),
        "Return on Equity": data["RETURN_COM_EQY"].shift(3),
        "Profit Margin":    data["PROF_MARGIN"].shift(3)
    }

    # Clip extreme tails specific to Operating Income
    oi = data["OPER_INC_GROWTH"].shift(3)
    factors["Op. Income Growth"] = oi.clip(lower=oi.quantile(0.02, axis=1),
                                           upper=oi.quantile(0.98, axis=1), axis=0)
    return factors


# ── Core Quantitative Tools ───────────────────────────────────────────────────

def zscore(df, winsorize=True, q=0.02):
    """Standardizes cross-sectional data with optional Winsorization."""
    if winsorize:
        lo, hi = df.quantile(q, axis=1), df.quantile(1 - q, axis=1)
        df = df.clip(lower=lo, upper=hi, axis=0)
    return df.apply(lambda row: (row - row.mean()) / (row.std() + 1e-9), axis=1)

def apply_buffer(scores, prev_positions, n_target, buffer_size, largest=True):
    """Applies hysteresis (N+buffer) to limit portfolio churn."""
    ideal = scores.nlargest(n_target + buffer_size) if largest else scores.nsmallest(n_target + buffer_size)
    kept = set(ideal.index).intersection(prev_positions)
    needed = n_target - len(kept)

    new_adds = set(ideal.drop(list(kept), errors='ignore').nlargest(needed).index) if largest \
               else set(ideal.drop(list(kept), errors='ignore').nsmallest(needed).index)
    return kept.union(new_adds)

def turnover_cost(prev, curr):
    """Calculates portfolio turnover and applies transaction costs."""
    if not prev: return COST_ONE_WAY
    if not curr: return 0.0
    return (len(curr - prev) + len(prev - curr)) / len(curr) * COST_ONE_WAY


# ── Central Simulation Engine ─────────────────────────────────────────────────

def run_simulation(signal_df, prices, largest_for_long=True):
    """
    Universal backtest engine.
    Accepts a pre-computed Signal DataFrame and executes buffered Long/Short trading.
    """
    # 1. Identify the tradable universe (intersection of signal and prices)
    common = signal_df.columns.intersection(prices.columns)
    signal_df = signal_df[common]
    fwd = prices[common].pct_change().shift(-1)

    returns, dates = [], []
    prev_long, prev_short = set(), set()

    for date in signal_df.index[:-1]:
        if date not in fwd.index: continue

        s = signal_df.loc[date].dropna()
        if len(s) < N_LONG + N_SHORT: continue

        long_t  = apply_buffer(s, prev_long, N_LONG, BUFFER, largest=largest_for_long)
        short_t = apply_buffer(s, prev_short, N_SHORT, BUFFER, largest=not largest_for_long)

        gross = fwd.loc[date, list(long_t)].mean() - fwd.loc[date, list(short_t)].mean()
        cost  = turnover_cost(prev_long, long_t) + turnover_cost(prev_short, short_t)

        if pd.notna(gross - cost):
            returns.append(gross - cost)
            dates.append(date)

        prev_long, prev_short = long_t, short_t

    return pd.Series(returns, index=dates)


# ── Strategy Definitions ──────────────────────────────────────────────────────

def get_aligned_universe(factors):
    """Finds the common ticker universe across all factor datasets."""
    return list(set.intersection(*[set(df.columns) for df in factors.values()]))

def combine_equal_weight(factors, prices):
    """Equally weights standardized factor Z-scores point-in-time."""
    tickers = get_aligned_universe(factors)
    zscored = {n: zscore(df[tickers]) for n, df in factors.items()}

    composite_data = []
    for date in list(factors.values())[0].index:
        date_scores = pd.concat([df.loc[date] for df in zscored.values()], axis=1).dropna()
        if not date_scores.empty:
            composite_data.append(date_scores.mean(axis=1).rename(date))

    composite_df = pd.concat(composite_data, axis=1).T
    return run_simulation(composite_df, prices, largest_for_long=True).rename("Equal Weight")

def combine_rank_rank(factors, prices):
    """Calculates cross-sectional rank averages on the intersected universe."""
    composite_data = []
    for date in list(factors.values())[0].index:
        date_factors = pd.concat([df.loc[date] for df in factors.values()], axis=1).dropna()
        if not date_factors.empty:
            composite_data.append(date_factors.rank(ascending=False).mean(axis=1).rename(date))

    composite_df = pd.concat(composite_data, axis=1).T
    # For ranks, smaller values represent the top decile
    return run_simulation(composite_df, prices, largest_for_long=False).rename("Rank-Rank")

def combine_risk_parity(factors, prices, factor_returns, min_periods=12, rolling_window=36):
    """Allocates capital inversely proportional to rolling historical factor volatility."""
    df_ret = pd.concat(factor_returns.values(), axis=1)
    df_ret.columns = list(factor_returns.keys())

    tickers = get_aligned_universe(factors)
    zscored = {n: zscore(df[tickers]) for n, df in factors.items()}

    composite_data = []
    for date in list(factors.values())[0].index:
        history = df_ret[df_ret.index < date]
        if len(history) < min_periods: continue

        recent_vols = history.tail(rolling_window).std()
        weights = (1 / recent_vols) / (1 / recent_vols).sum()

        date_scores = pd.concat([df.loc[date] for df in zscored.values()], axis=1).dropna()
        if not date_scores.empty:
            date_scores.columns = list(factors.keys())
            composite_data.append((date_scores * weights).sum(axis=1).rename(date))

    composite_df = pd.concat(composite_data, axis=1).T
    return run_simulation(composite_df, prices, largest_for_long=True).rename("Risk Parity")


# ── Performance & Reporting ───────────────────────────────────────────────────

def metrics(returns):
    ann_ret = returns.mean() * 12
    ann_vol = returns.std() * np.sqrt(12)
    sharpe  = (returns.mean() / (returns.std() + 1e-9)) * np.sqrt(12)
    cum     = (1 + returns).cumprod()
    max_dd  = ((cum - cum.cummax()) / cum.cummax()).min()
    return {
        "Ann. Return":       f"{ann_ret:.2%}",
        "Ann. Volatility":   f"{ann_vol:.2%}",
        "Sharpe Ratio":      f"{sharpe:.2f}",
        "Max Drawdown":      f"{max_dd:.2%}",
        "Calmar Ratio":      f"{ann_ret / abs(max_dd) if max_dd != 0 else np.nan:.2f}",
        "% Positive Months": f"{(returns > 0).mean():.2%}",
    }

def print_metrics(label, ret):
    print(f"\n{label}")
    for k, v in metrics(ret).items(): print(f"  {k:<22} {v}")

def plot_factor_comparison(factor_returns, save_path):
    plt.figure(figsize=(12, 6))
    plt.title("Individual Factor Performance", fontsize=14, fontweight="bold")
    colors = ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728"]
    for (name, ret), col in zip(factor_returns.items(), colors):
        plt.plot((1 + ret[ret.index >= START_DATE]).cumprod(), label=name, linewidth=1.8, color=col)
    plt.axhline(1, color="black", linewidth=0.7, linestyle="--")
    plt.axvline(pd.Timestamp(OUTSAMPLE_START), color="grey", linewidth=1, linestyle=":", label="OOS Start")
    plt.ylabel("Growth of $1")
    plt.legend(fontsize=10)
    plt.gca().xaxis.set_major_formatter(mdates.DateFormatter("%Y"))
    plt.grid(alpha=0.3)
    plt.tight_layout()
    plt.savefig(save_path, dpi=150, bbox_inches="tight")
    plt.show()
    plt.close()

def plot_strategy_tearsheet(strategy_returns, name, save_path):
    fig, axes = plt.subplots(3, 1, figsize=(12, 12))
    fig.suptitle(f"{name} Strategy — Performance Tear Sheet", fontsize=15, fontweight="bold")

    ret = strategy_returns[strategy_returns.index >= START_DATE]
    cum_ret = (1 + ret).cumprod()

    # Cumulative Return
    axes[0].plot(cum_ret, color="navy", linewidth=2, label=f"{name} Cumulative")
    axes[0].fill_between(cum_ret.index, 1, cum_ret.values, where=cum_ret.values>=1, alpha=0.15, color="green")
    axes[0].fill_between(cum_ret.index, 1, cum_ret.values, where=cum_ret.values<1, alpha=0.15, color="red")
    axes[0].set_title("Cumulative Return", fontsize=12)
    axes[0].set_ylabel("Growth of $1")

    # Rolling Sharpe
    roll_sh = ret.rolling(12).apply(lambda x: (x.mean() / (x.std() + 1e-9)) * np.sqrt(12))
    axes[1].plot(roll_sh, color="darkorange", linewidth=1.5, label="12M Rolling Sharpe")
    axes[1].set_title("Rolling 12-Month Sharpe Ratio", fontsize=12)
    axes[1].set_ylabel("Sharpe Ratio")

    # Drawdown
    roll_max = cum_ret.cummax()
    drawdown = (cum_ret - roll_max) / roll_max
    axes[2].fill_between(drawdown.index, drawdown.values, 0, color="firebrick", alpha=0.6, label="Drawdown")
    axes[2].set_title("Strategy Drawdown", fontsize=12)
    axes[2].set_ylabel("Percentage Drop")
    axes[2].yaxis.set_major_formatter(plt.FuncFormatter(lambda y, _: '{:.0%}'.format(y)))

    for ax in axes:
        ax.axhline(1 if ax == axes[0] else 0, color="black", linewidth=0.7, linestyle="--")
        ax.axvline(pd.Timestamp(OUTSAMPLE_START), color="grey", linewidth=1.5, linestyle=":", label="OOS start" if ax == axes[0] else "")
        ax.legend(loc="upper left" if ax != axes[2] else "lower left")
        ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y"))
        ax.grid(alpha=0.3)

    plt.tight_layout()
    fig.subplots_adjust(top=0.93)
    plt.savefig(save_path, dpi=150, bbox_inches="tight")
    plt.show()
    plt.close()


# ── Main Execution ────────────────────────────────────────────────────────────

def main():
    data = load_excel(EXCEL_PATH)
    prices = data["PX_LAST"][data["PX_LAST"].index >= START_DATE]
    raw_factors = build_factors(data)
    factors = {n: df[df.index >= START_DATE] for n, df in raw_factors.items()}

    print(f"\nUniverse: {prices.shape[1]} tickers | {prices.shape[0]} months ({START_DATE[:4]}–present)")
    print("\n── Individual factors (net of 5bps one-way costs) ──")

    factor_returns = {}
    for name, fdf in factors.items():
        # Abstracted factor returns using the universal simulation engine
        ret = run_simulation(zscore(fdf), prices, largest_for_long=True)
        factor_returns[name] = ret
        print_metrics(name, ret)

    print("\n── Combined strategies ──")
    strategies = {
        "Equal Weight": combine_equal_weight(factors, prices),
        "Rank-Rank":    combine_rank_rank(factors, prices),
        "Risk Parity":  combine_risk_parity(factors, prices, factor_returns),
    }

    print(f"\n── In-sample ({START_DATE[:4]}–{INSAMPLE_END[:4]}) ──")
    for name, s in strategies.items():
        print_metrics(name, s[s.index <= INSAMPLE_END])

    print(f"\n── Out-of-sample ({OUTSAMPLE_START[:4]}–present) ──")
    for name, s in strategies.items():
        oos = s[s.index >= OUTSAMPLE_START]
        if not oos.empty: print_metrics(name, oos)

    # Output Visualizations
    plot_factor_comparison(factor_returns, "factors_comparison.png")
    for name, s_returns in strategies.items():
        plot_strategy_tearsheet(s_returns, name, f"tearsheet_{name.replace(' ', '_')}.png")

    return factor_returns, strategies

if __name__ == "__main__":
    factor_returns, strategies = main()